2850 SUB SUB4(AJ$)
  LOCATE 13,3
  PRINT "Use command line parameter  "; AJ$; "  with PC-ZIPPER"
  LOCATE 10,51
  PRINT "                "
  AV$ = "A"
  AW% = 65
  AX% = 3
  DO
  IF AV$ = AJ$ THEN
    LOCATE 11,AX%
    PRINT CHR$(24)
  ELSE
    AX% = AX% + 2
    AW% = AW% + 1
    AV$ = CHR$(AW%)
    LOOP
  END IF
  LOCATE 15,1
  END
END SUB
2860 DEF FNFN1
  AY$ = "abcdefghijklm"
  AZ$ = "NOPQRSTUVWXYZ"
  BA = 3.14159
  BB = 514396.12
  BC% = 76
  BD% = 477
  MTIMER
  FOR BE = 1 TO 35
  SWAP AY$, AZ$
  C = BA * BB
  B = C / BA
  BF% = BC% + BD%
  BG% = BF% - BC%
  FOR BH = 1 TO 5
  NEXT BH
  NEXT BE
  BI = MTIMER
  FNFN1 = BI
END DEF
